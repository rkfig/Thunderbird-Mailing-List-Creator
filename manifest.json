{
  "manifest_version": 2,
  "name": "Mailing List Creator",
  "description": "Create Thunderbird mailing lists from selected message recipients.",
  "version": "2.0.0",
  "author": "Ryan Figgins",
  "homepage_url": "https://github.com/rkfig/Thunderbird-Mailing-List-Creator.git",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailing-list-creator@rkfig.com",
      "strict_min_version": "153.0"
    }
  },
  "permissions": [
    "addressBooks",
    "messagesRead",
    "notifications",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/background/main.js"
    ]
  },
  "browser_action": {
    "default_title": "Mailing List"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true,
    "browser_style": true
  },
  "icons": {
    "16": "images/icon-16.svg",
    "32": "images/icon-32.svg",
    "64": "images/icon-64.svg"
  }
}
